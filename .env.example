# =============================================================================
# aws-ds — modèle de configuration
#
# Copier ce fichier en `.env` et renseigner les valeurs.
# `.env` n'est JAMAIS committé (voir .gitignore).
#
# Sur les machines de travail des binômes, les clés AWS sont ABSENTES : le profil
# d'instance EC2 fournit les permissions et la chaîne de résolution boto3 par
# défaut prend le relais. Les clés statiques ne servent qu'au formateur ou à un
# poste hors VPC.
#
# Aucun script ne lit os.environ directement : tout passe par qc/config.py.
# =============================================================================

# --- Région ------------------------------------------------------------------
# Source de vérité unique. Interdiction de coder une région en dur ou de
# s'appuyer sur la région par défaut du SDK.
AWS_REGION=eu-west-3

# --- Credentials (optionnels, absents sur les workstations) -------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Identité du groupe -------------------------------------------------------
# Format imposé et validé par regex : ^g[0-9]{2}$  (g01, g02, …)
TEAM_ID=
PROJECT=aws-ds
OWNER_EMAIL=
# Fourni par `make env-from-tf`. Nécessaire au module Terraform de votre équipe pour
# relire l'état du socle ; ce n'est ni un secret ni un identifiant AWS.
TF_STATE_BUCKET=

# --- S3 -----------------------------------------------------------------------
# Dérivé par qc/config.py si vide : qc-<TEAM_ID>-data-<suffixe compte>
# Le suffixe de compte est nécessaire : les noms de bucket sont uniques au monde.
S3_BUCKET=

# --- SageMaker ----------------------------------------------------------------
SAGEMAKER_ROLE_ARN=
# Régression logistique sur ~40 features et 1567 lignes : le CPU suffit, pas de GPU.
SAGEMAKER_TRAIN_INSTANCE=ml.m5.large
SAGEMAKER_ENDPOINT_INSTANCE=ml.m5.large
# Dérivé si vide : qc-<TEAM_ID>-endpoint
SAGEMAKER_ENDPOINT_NAME=

# --- Bedrock ------------------------------------------------------------------
# Contrainte : le modèle doit supporter le TOOL USE via l'API Converse.
#
# Valeur vérifiée par la sonde du 2026-07-27 dans le compte de formation :
# c'est le SEUL modèle réellement appelable. Nova Lite, Nova Pro et tous les
# modèles Anthropic sont au catalogue mais renvoient AccessDeniedException.
#
# Attention : c'est un modelId BRUT, pas un profil d'inférence `eu.*`. Les deux
# formes coexistent dans la région et le preflight doit accepter les deux —
# certains modèles ne sont invocables QUE via un profil `eu.` ou `global.`.
#
# Pour revérifier après un changement d'accès :  uv run scripts/discover.py
BEDROCK_MODEL_ID=mistral.mistral-large-2402-v1:0
BEDROCK_MAX_TOKENS=2048

# --- Conteneurs et exécution --------------------------------------------------
# Dérivé si vide : qc-<TEAM_ID>-app
ECR_REPO=
ECS_CLUSTER=
ECS_SERVICE=

# --- Exposition ---------------------------------------------------------------
# ALB interne UNIQUE, partagé par toute la promo, créé dans le socle.
# Routage par chemin /<TEAM_ID>/ ; l'application Streamlit doit donc être
# démarrée avec --server.baseUrlPath=<TEAM_ID> (voir décision D12).
ALB_DNS_NAME=
# Mode dégradé retenu : ALB interne en HTTP. ACM et HTTPS sont traités en
# démonstration commentée. Laisser vide.
ACM_CERT_ARN=

# --- MLflow -------------------------------------------------------------------
# ARN du tracking server SageMaker managed MLflow, créé dans le socle.
# Une expérience par groupe, nommée qc-<TEAM_ID>.
MLFLOW_TRACKING_URI=

# --- Divers -------------------------------------------------------------------
LOG_LEVEL=INFO

# Nombre de binômes de la promotion. Sert au contrôle de quota du preflight : en
# compte partagé, un quota calculé pour un seul groupe fait échouer la formation
# entière au moment du déploiement simultané.
TEAMS_COUNT=6
